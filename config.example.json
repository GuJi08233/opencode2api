{
  "listen": "127.0.0.1:8080",
  "server_keys": ["change-this-local-key"],
  "proxies": ["direct"],
  "proxyfile": "",
  "upstream": {
    "zen": "https://opencode.ai/zen",
    "anonymous": "https://opencode.ai/inference"
  },
  "retry": {
    "max_attempts": 3,
    "anonymous_max_attempts": 0,
    "timeout_seconds": 300
  },
  "models": {
    "refresh_seconds": 300,
    "protocols": {}
  },
  "performance": {
    "disable_proxy_keep_alives": false,
    "max_idle_conns": 4096,
    "max_idle_conns_per_host": 1024,
    "max_conns_per_host": 0,
    "idle_conn_timeout_seconds": 120,
    "connect_timeout_seconds": 5,
    "failure_cooldown_seconds": 15,
    "attempt_timeout_seconds": 0,
    "first_event_timeout_seconds": 0
  },
  "logging": {
    "level": "info",
    "dump_request_bodies": false
  },
  "reasoning": {
    "effort": "high",
    "effort_by_model": {}
  }
}
